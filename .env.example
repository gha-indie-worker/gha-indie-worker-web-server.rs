# gha-indie-worker-web-server — example environment.
#
# Copy to a local `.env` for development only. Deployed environments get their
# values from ores-sops (`env/enc/<env>.env.enc`, decrypted at `docker run` by
# scripts/sops-entrypoint.sh) — never from a committed file.
#
# Nothing here is a real secret. Every key is declared in `.cli-flags.toml`.

# ---- process ---------------------------------------------------------------
GHA_INDIE_WORKER_ENV=development
GHA_INDIE_WORKER_WEB_BIND=127.0.0.1:8081
RUST_LOG=info

# ---- host routing ----------------------------------------------------------
# app.indiebuild.dev / user. / org. / m. all resolve to this one process.
GHA_INDIE_WORKER_BASE_DOMAIN=indiebuild.dev
# Which surface `localhost` serves while developing: app, user, org or m.
GHA_INDIE_WORKER_DEV_SURFACE=app
# Only these peers may set X-Forwarded-Host. Unset in production to use the
# built-in Cloudflare ranges.
GHA_INDIE_WORKER_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128

# ---- avenues ---------------------------------------------------------------
# 2. stateless HTTP: every write, and reads the database cannot answer.
GHA_INDIE_WORKER_API_HTTP_BASE=http://127.0.0.1:8080
# 1. direct read-only SeaORM. A READ-ONLY role. Leave empty to read via the API.
DATABASE_URL_CANONICAL=
# 3. stateful TCP (operator tooling only; never exposed through Cloudflare).
GHA_INDIE_WORKER_WEB_TCP_BIND=127.0.0.1:8181
# 4. async NATS/JetStream.
GHA_INDIE_WORKER_NATS_URL=nats://127.0.0.1:4222

# ---- sessions, CSRF, rate limiting ----------------------------------------
# Required in production. `openssl rand -hex 32` locally.
GHA_INDIE_WORKER_SESSION_SECRET=development-only-not-a-secret
GHA_INDIE_WORKER_SESSION_COOKIE_NAME=giw_session
GHA_INDIE_WORKER_CSRF_COOKIE_NAME=giw_csrf
GHA_INDIE_WORKER_SESSION_TTL_SECONDS=43200
GHA_INDIE_WORKER_RATE_LIMIT_HMAC_SECRET=development-only-not-a-secret

# ---- shared-auth (product instance) ----------------------------------------
# Admin bases are deliberately absent: this server must never accept an
# admin-instance token.
SHARED_AUTH_BASE=https://auth.indiebuild.dev/shared-auth
SHARED_AUTH_AUDIENCE=gha-indie-worker-web
SHARED_AUTH_INTROSPECT_SECRET=
# shared-auth federates these two; a session JWT from either is also accepted.
SUPABASE_URL=
SUPABASE_JWKS_URL=
NEON_AUTH_URL=
NEON_AUTH_JWKS_URL=
GHA_INDIE_WORKER_JWT_ISSUERS=
GHA_INDIE_WORKER_JWT_AUDIENCES=
GHA_INDIE_WORKER_JWKS_TTL_SECONDS=300

# ---- assets and islands ----------------------------------------------------
# Served at /assets. Run scripts/vendor-assets.sh to populate assets/vendor.
GHA_INDIE_WORKER_ASSETS_DIR=assets
# Last path segment is the release id used for /assets/releases/<id>/…
GHA_INDIE_WORKER_RELEASE_MANIFEST_URL=

# ---- chat ------------------------------------------------------------------
GHA_INDIE_WORKER_CHAT_ENABLED=true

# ---- ores-middleware -------------------------------------------------------
ORES_MIDDLEWARE_ENV=development
ORES_MIDDLEWARE_TLS_MODE=disabled
# In production:
#   ORES_MIDDLEWARE_TLS_MODE=trusted-proxy
#   ORES_MIDDLEWARE_TRUSTED_PROXY_CIDRS=<cloudflare ranges>
#   ORES_MIDDLEWARE_RATE_LIMIT_HMAC_SECRET=<from sops>
ORES_MIDDLEWARE_RATE_LIMIT_ENABLED=true
ORES_MIDDLEWARE_TIMEOUT_MS=15000
# Set to `off` to install the pipeline without this service's auth/limit hooks.
GHA_INDIE_WORKER_MIDDLEWARE_INTEGRATIONS=on
