/target
/node_modules
/build
/.dart_tool
/coverage
.DS_Store
.env
.env.*
!.env.example
*.sqlite



# BEGIN ores-sops dotenv policy
*.env
*/*.env
*/**/*.env
.env.*
*.env.*
!.env.example
/env/dec/
/env/enc/*
!/env/enc/dev.env.enc
!/env/enc/prod.env.enc
# END ores-sops dotenv policy

# Repository-local temporary data and authorized Git worktrees
tmp
temp
tmp/worktrees
temp/worktrees
# typespec-json-schema-validator comparison evidence (generated; never an authority)
.typespec-json-schema-validator/

# Vendored browser assets are fetched (and pin-verified) by scripts/vendor-assets.sh, not committed.
/assets/vendor/htmx.min.js
/assets/releases/*
!/assets/releases/.gitkeep

# Package-local installs must never be published.
node_modules/
# Executable services need a reviewed lockfile for the existing --locked CI gate.
!Cargo.lock
